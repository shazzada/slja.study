{"id": 8342, "doi": "10.4038/slja.v26i2.8342", "title": "Anaesthesia for Transoral Endoscopic Thyroidectomy", "abstract": "<p><span>The expanding realm of minimally invasive surgery incorporate specific anaesthetic challenges. This report transcribes the anaesthetic technique for the first successful Transoral Endoscopic Thyroidectomy (TOET) performed in Sri Lanka using 3-dimensional (3D) endoscopy at National Hospital of Sri Lanka.</span></p>", "keywords": ["Transoral Endoscopic Thyroidectomy", "Nasal intubation", "Hypercarbia"], "authors": [{"first_name": "Charaka Yapa", "last_name": "Abeywardana", "institution": "National Hospital of Sri Lanka", "country": "LK", "email": "charaka3@yahoo.co.uk", "orcid": "https://orcid.org/0000-0002-1708-4509"}, {"first_name": "Ramya", "last_name": "Amarasena", "institution": "National Hospital of Sri Lanka", "country": "LK", "email": "", "orcid": ""}], "section": "Case Reports", "pages": "159-161", "date_published": "2018-07-15T05:27:10+00:00", "date_submitted": "2018-05-24T00:56:05+00:00", "license_name": "", "license_link": "", "files": [{"label": "PDF", "language": "en", "url": "https://slja.sljol.info/articles/8342/files/8342-1-30726-1-10-20180718.pdf"}], "references": "", "volume": 26, "number": "2", "year": 2018, "issue_id": 739}